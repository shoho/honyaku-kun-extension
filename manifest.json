{
  "manifest_version": 3,
  "name": "翻訳くん",
  "version": "1.0.0",
  "description": "英⇄日をその場で翻訳。アイコンをクリックすると右側のサイドパネルが開きます。Gemini で自然な翻訳。",
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "翻訳くんを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
